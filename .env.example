# Server-side environment variables (example values)

# Supabase Postgres
# - DATABASE_URL: pooled/transaction URL (good for runtime)
# - DIRECT_URL: direct/non-pooled URL (recommended for Prisma migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth
JWT_SECRET="replace_me"

# App
NEXT_PUBLIC_APP_NAME="CYOA Author"

# Local-only mode (no DB/auth). Set to "true" when Supabase is configured.
NEXT_PUBLIC_ENABLE_SERVER="false"
